# API server
PORT=5000
NODE_ENV=development
# Comma-separated browser origins; add your LAN URL when testing from another device
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB: use a dedicated empty HCM database for development/judging
MONGODB_URI=mongodb://127.0.0.1:27017/hcm-lite
MONGODB_DB_NAME=hcm-lite

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI provider (server-side only; keep the real key in .env)
AI_API_KEY=replace-with-your-provider-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite
